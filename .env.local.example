# ============================================================
# データベース（必須）
# ============================================================
# ローカル開発: docker-compose.yml の Postgres（npm run db:up で起動）
DATABASE_URL=postgres://app:app@localhost:5434/app
#
# クラウド（本番はシークレット管理に入れる。ここに平文で置かない）
#   AWS RDS   : postgres://postgres:<password>@<id>.<xxxx>.ap-northeast-1.rds.amazonaws.com:5432/app
#   Azure     : postgres://<user>:<password>@<name>.postgres.database.azure.com:5432/app

# TLS モード: disable / require / verify-full
# 未指定ならローカル（localhost / host.docker.internal / db）は disable、それ以外は require。
# require は暗号化するだけで証明書を検証しないため、本番は verify-full にする
# DATABASE_SSL=verify-full

# verify-full 用の CA 証明書。PEM 本文か base64 を直接、またはファイルパスを指定する
#   AWS  : curl -o rds-ca.pem https://truststore.pki.rds.amazonaws.com/ap-northeast-1/ap-northeast-1-bundle.pem
#   Azure: curl -o azure-ca.pem https://cacerts.digicert.com/DigiCertGlobalRootG2.crt.pem
# DATABASE_CA_CERT=
# DATABASE_CA_CERT_PATH=/app/certs/rds-ca.pem

# 1 プロセスあたりの最大接続数（未指定なら 5）。
# 「この値 × 最大インスタンス数」が DB の max_connections（t4g.micro / B1ms は約 80）を超えないこと
# DATABASE_POOL_MAX=5
#
# ローカル Postgres のホスト側ポート（デフォルト 5434）。
# 他プロジェクトと衝突したら .env に DB_PORT=5435 を書いて DATABASE_URL も合わせる
# ※ docker compose は .env.local ではなく .env を読む点に注意

# ============================================================
# 認証 / デモ表示
# ============================================================
# true にするとログイン画面にデモ用アカウントを初期入力する。
# 外部にデモを見せる本番環境では必ず外すこと。
# ※ NEXT_PUBLIC_* はビルド時にバンドルへ焼き込まれるため、Docker では
#    実行時の環境変数ではなく --build-arg で渡す必要がある
NEXT_PUBLIC_DEMO_LOGIN_HINT=true

# npm run db:seed で作られるアカウントのパスワード（未指定なら demo1234）
# SEED_ADMIN_PASSWORD=
# SEED_MEMBER_PASSWORD=

# ============================================================
# AI / 外部 API（使う演習だけ設定すればよい）
# ============================================================
# OpenAI チャットボット用。https://platform.openai.com/api-keys
# 未設定ならモック応答で動作する
OPENAI_API_KEY=

# 使用する OpenAI モデルの上書き（デフォルト: gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# 健康アシスタント音声 bot（OpenAI Realtime）のモデル上書き（デフォルト: gpt-realtime）
OPENAI_REALTIME_MODEL=gpt-realtime

# Google ADK（AI ワークフロー / エージェントのサンプル）用の Gemini API キー
# https://aistudio.google.com/apikey で取得できる
GOOGLE_API_KEY=

# 使用する Gemini モデルの上書き（デフォルト: gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=

# true のとき、LLM 呼び出しをモック応答に差し替える（ローカル開発・E2E 用）
# GOOGLE_API_KEY 未設定時も自動的にモックにフォールバックする
NEXT_PUBLIC_MOCK_LLM=true

# ============================================================
# 法令 RAG（AWS 東京が本番前提。ローカルは制度確認用）
# ============================================================
# local | demo | prod
APP_ENV=local
# 本番リージョン。ローカルでも「前提」を揃える
AWS_REGION=ap-northeast-1
# fs（既定・ローカル） / s3（MinIO または AWS S3）
# RAG_STORAGE=fs
# RAG_LOCAL_DIR=data/rag/objects
# 回答: extractive（引用を組み立てる） / openai / bedrock
# OPENAI_API_KEY があれば条例チャットは自動で OpenAI を使う
RAG_LLM=extractive
# RAG_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
#
# MinIO（npm run env:up）を使うとき
# RAG_STORAGE=s3
# RAG_S3_BUCKET=rag-local
# RAG_S3_PREFIX=local
# RAG_S3_ENDPOINT=http://localhost:9000
# RAG_S3_ACCESS_KEY=rag
# RAG_S3_SECRET_KEY=ragsecret
#
# AWS デモ / 本番（Secrets Manager に置く。ここには書かない）
# RAG_S3_BUCKET=your-rag-demo
# RAG_S3_PREFIX=demo
#
# ローカル参照グラフ（Neo4j）。未指定かつ APP_ENV=local なら bolt://localhost:7687
#   npm run graph:up
# 止めるとき: NEO4J_URI=off
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=raglocal
# NEO4J_BROWSER_URL=http://localhost:7474
