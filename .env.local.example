# OpenAI API key for AI commentary generation (T14)
# Leave NEXT_PUBLIC_MOCK_LLM=true to use the mocked LLM response without hitting the API
OPENAI_API_KEY=

# Optional: override the model used by /api/generate-commentary
# Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Legacy — Anthropic SDK is still listed as a dependency for historical reasons
# but the active route uses OpenAI. Set this only if you intend to switch back.
ANTHROPIC_API_KEY=

# When true, the AI commentary endpoint returns a deterministic mocked response
# Used by local development and all Playwright E2E runs
NEXT_PUBLIC_MOCK_LLM=true
