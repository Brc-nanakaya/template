# デモ環境（AWS 東京）。実キーはリポジトリに置かない。
APP_ENV=demo
AWS_REGION=ap-northeast-1
DATABASE_URL=postgres://postgres:<password>@<rds-demo>.ap-northeast-1.rds.amazonaws.com:5432/app
DATABASE_SSL=verify-full
NEXT_PUBLIC_DEMO_LOGIN_HINT=true
NEXT_PUBLIC_MOCK_LLM=false
RAG_STORAGE=s3
RAG_S3_BUCKET=<demo-bucket>
RAG_S3_PREFIX=demo
RAG_LLM=extractive
# デモで Bedrock を試すときだけ
# RAG_LLM=bedrock
# RAG_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
