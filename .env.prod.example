# 本番環境（AWS 東京）。デモ用バケット・DB・アカウントと混ぜない。
APP_ENV=prod
AWS_REGION=ap-northeast-1
DATABASE_URL=postgres://postgres:<password>@<rds-prod>.ap-northeast-1.rds.amazonaws.com:5432/app
DATABASE_SSL=verify-full
NEXT_PUBLIC_DEMO_LOGIN_HINT=false
NEXT_PUBLIC_MOCK_LLM=false
RAG_STORAGE=s3
RAG_S3_BUCKET=<prod-bucket>
RAG_S3_PREFIX=prod
RAG_LLM=bedrock
RAG_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
SEED_ADMIN_PASSWORD=<strong-password>
