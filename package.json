{
  "name": "training-template",
  "version": "0.1.0",
  "private": true,
  "description": "研修用 Web アプリ開発テンプレート",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:e2e",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "build:scripts": "esbuild scripts/db-migrate.ts scripts/db-seed.ts scripts/db-user.ts scripts/rag-ingest.ts scripts/rag-eval.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist/scripts --out-extension:.js=.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:user": "tsx scripts/db-user.ts",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:reset": "npm run db:nuke && npm run db:setup",
    "env:up": "docker compose --profile rag up -d --wait",
    "graph:up": "docker compose --profile graph up -d --wait neo4j",
    "graph:down": "docker compose --profile graph stop neo4j",
    "rag:ingest": "tsx scripts/rag-ingest.ts",
    "rag:eval": "tsx scripts/rag-eval.ts",
    "rag:graph-sync": "tsx scripts/rag-graph-sync.ts",
    "docker:build": "docker build -t template-app .",
    "docker:up": "docker compose --profile app up --build -d --wait",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs -f app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@aws-sdk/client-bedrock-runtime": "^3.901.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@google/adk": "^1.2.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.454.0",
    "neo4j-driver": "^6.2.0",
    "next": "14.2.18",
    "openai": "^6.34.0",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^2.9.3",
    "react-markdown": "^9.0.1",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
